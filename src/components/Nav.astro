---
import CV from "../assets/cv-aaron-conway.pdf";
import Memoji1 from "../assets/memoji-1.webp";
import Memoji2 from "../assets/memoji-2.webp";
import Memoji3 from "../assets/memoji-3.webp";
import NavLinkList from "./NavLinkList.astro";

// Navigation configuration - easy to maintain and extend
const navItems = [
  {
    id: "projects",
    name: "Projects",
    type: "parent", // has children
    children: [
      {
        name: "BillSplitr",
        url: "https://usebillsplitr.netlify.app/",
        emoji: "🧾"
      },
      {
        name: "FootyText",
        url: "https://footytext.netlify.app/news",
        emoji: "📺",
      },
      {
        name: "Rona",
        url: "https://rona.netlify.app/",
        emoji: "🦠",
      },
      {
        name: "The Third Wheel",
        url: "https://thethirdwheel.netlify.app",
        emoji: "🎙️",
      },
      {
        name: "Sweepstake",
        url: "https://sweepstake.netlify.app/#!/",
        emoji: "🏆",
      },
      {
        name: "Eden",
        url: "https://geteden.netlify.app/",
        emoji: "🌳",
      },
      {
        name: "Lush Heat Treatment Ltd",
        url: "https://lush-heat.com/",
        emoji: "🥵",
      },
      {
        name: "FDIS",
        url: "https://fdisuk.com/",
        emoji: "🔥",
      },
      {
        name: "MoneyWiseQuoteMe",
        url: "https://www.moneywisequoteme.com/",
        emoji: "💸",
      },
    ],
  },
  {
    id: "socials",
    name: "Socials",
    type: "parent", // has children
    children: [
      {
        name: "Twitter",
        emoji: "🐦",
        url: "https://twitter.com/aaronconway7",
      },
      {
        name: "Instagram",
        emoji: "📸",
        url: "https://www.instagram.com/aaronconway7/",
      },
    ],
  },
  {
    id: "cv-btn",
    name: "CV",
    type: "button",
    url: CV,
    target: "_blank",
  },
];

const parentItems = navItems.filter((item) => item.type === "parent");

// Passed to the client so cycling works with Astro's hashed filenames
const memojis = [Memoji1, Memoji2, Memoji3].map((memoji) => memoji.src);
---

<nav
  class="nav bg-[#302e2c99] fixed top-8 right-8 backdrop-blur-lg rounded-3xl py-3 px-6 z-10 flex gap-6 items-center overflow-hidden"
>
  <button
    id="nav-toggle"
    class="nav-icon flex items-center justify-center cursor-pointer"
    aria-label="Change memoji"
  >
    <img
      id="memoji"
      src={Memoji1.src}
      width={Memoji1.width}
      height={Memoji1.height}
      class="h-12 w-auto"
      alt=""
      data-memojis={JSON.stringify(memojis)}
    />
    <svg
      id="back-icon"
      class="text-[var(--off-white)] hidden h-6 opacity-25 hover:opacity-50 link"
      aria-hidden="true"
      viewBox="0 0 24 24"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M3 9H16.5C18.9853 9 21 11.0147 21 13.5C21 15.9853 18.9853 18 16.5 18H12M3 9L7 5M3 9L7 13"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </button>

  <ul id="main-nav" class="flex flex-1 gap-6 items-center whitespace-nowrap">
    {
      navItems.map((item) => (
        <li>
          {item.type === "link" ? (
            <a
              class="link text-[var(--off-white)] uppercase hover:underline hover:text-[var(--red)] font-[JetBrains_Mono_Variable] tracking-wide leading-[1] underline-offset-4"
              href={item.url}
              target={item.target || "_self"}
            >
              {item.name}
            </a>
          ) : item.type === "button" ? (
            <a
              class="link bg-[var(--red)] hover:bg-[var(--off-white)] text-[#181818] rounded-lg px-4 py-2 uppercase font-[JetBrains_Mono_Variable] tracking-wide leading-[1]"
              href={item.url}
              target={item.target || "_self"}
              rel={item.target === "_blank" ? "noopener" : undefined}
            >
              {item.name}
            </a>
          ) : (
            <button
              id={`${item.id}-btn`}
              class="link parent-btn text-[var(--off-white)] uppercase hover:underline hover:text-[var(--red)] aria-expanded:underline aria-expanded:text-[var(--red)] font-[JetBrains_Mono_Variable] tracking-wide leading-[1] underline-offset-4 cursor-pointer py-2 -my-2"
              aria-expanded="false"
              aria-controls={`${item.id}-panel`}
            >
              {item.name}
            </button>
          )}
        </li>
      ))
    }
  </ul>

  <!-- Dropdown panel for Projects / Socials -->
  <div id="nav-panel" class="nav-panel basis-full overflow-hidden" hidden>
    <div class="overflow-y-auto max-h-[60dvh] pt-3 border-t border-white/10">
      {
        parentItems.map((parentItem) => (
          <div
            id={`${parentItem.id}-panel`}
            class="panel-list"
            role="region"
            aria-labelledby={`${parentItem.id}-btn`}
            hidden
          >
            <NavLinkList items={parentItem.children} />
          </div>
        ))
      }
    </div>
  </div>
</nav>

<style>
  :root {
    --off-white: #eeebdd;
    --red: #fa4b4a;
  }

  .link {
    transition:
      background-color 0.2s cubic-bezier(0.165, 0.84, 0.44, 1),
      color 0.2s cubic-bezier(0.165, 0.84, 0.44, 1);
  }

  .nav-icon {
    transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
  }

  .nav-icon:hover {
    transform: scale(1.05);
  }

  /* Hidden until the intro reveals it, but only when JS can do the revealing */
  :global(.js) nav {
    opacity: 0;
  }

  nav {
    width: max-content;
    max-width: calc(100vw - var(--spacing) * 8 - var(--spacing) * 8);
    flex-wrap: wrap;
    row-gap: 0;
    transition: background-color 0.3s;
  }

  /* More opaque while open so the list reads over the card */
  nav:has(.nav-panel:not([hidden])) {
    background-color: #302e2ce6;
  }

  #main-nav {
    min-height: 48px;
  }

  /* Panel matches the bar's width instead of stretching the pill */
  .nav-panel {
    contain: inline-size;
  }

  .nav-panel > div {
    margin-top: calc(var(--spacing) * 3);
    margin-bottom: calc(var(--spacing) * -1);
    margin-inline: calc(var(--spacing) * -3);
    padding-inline: calc(var(--spacing) * 1);
  }

  /* Landscape phones: give the card more room */
  @media (max-height: 500px) {
    nav {
      top: calc(var(--spacing) * 4);
    }
  }

  @media (max-width: 639px) {
    nav {
      top: calc(var(--spacing) * 4);
      left: calc(var(--spacing) * 4);
      right: calc(var(--spacing) * 4);
      width: auto;
      max-width: none;
      padding-inline: calc(var(--spacing) * 4);
      column-gap: calc(var(--spacing) * 4);
    }

    #main-nav {
      justify-content: flex-end;
      gap: calc(var(--spacing) * 5);
    }
  }
</style>

<script>
  import { gsap } from "gsap";

  document.addEventListener("DOMContentLoaded", function () {
    const nav = document.querySelector(".nav");
    const navToggle = document.getElementById("nav-toggle");
    const memoji = document.getElementById("memoji");
    const backIcon = document.getElementById("back-icon");
    const panel = document.getElementById("nav-panel");
    const parentButtons = [...document.querySelectorAll(".parent-btn")];

    const memojiImages = JSON.parse(memoji.dataset.memojis);
    let currentMemojiIndex = 0;
    let openId = null;

    function cycleMemoji() {
      currentMemojiIndex = (currentMemojiIndex + 1) % memojiImages.length;
      memoji.src = memojiImages[currentMemojiIndex];
    }

    // Memoji <-> back arrow
    function swapIcon(showBack) {
      const [from, to] = showBack ? [memoji, backIcon] : [backIcon, memoji];
      navToggle.setAttribute("aria-label", showBack ? "Close menu" : "Change memoji");
      gsap
        .timeline()
        .to(from, { scale: 0, rotation: 180, duration: 0.2, ease: "power2.inOut" })
        .set(from, { display: "none" })
        .set(to, { display: "block", scale: 0, rotation: -180 })
        .to(to, { scale: 1, rotation: 0, duration: 0.2, ease: "power2.inOut" }, "-=0.05");
    }

    function showList(id) {
      parentButtons.forEach((btn) =>
        btn.setAttribute("aria-expanded", String(btn.id === `${id}-btn`))
      );
      document.querySelectorAll(".panel-list").forEach((list) => {
        list.hidden = list.id !== `${id}-panel`;
      });
      const list = document.getElementById(`${id}-panel`);
      gsap.fromTo(
        list.querySelectorAll("li"),
        { y: -6, opacity: 0 },
        { y: 0, opacity: 1, duration: 0.25, stagger: 0.03, ease: "power2.out" }
      );
      list.querySelector("a")?.focus({ preventScroll: true });
    }

    function open(id) {
      if (openId === id) return close();

      if (openId) {
        // Switching Projects <-> Socials: keep the panel, swap the list
        const startHeight = panel.offsetHeight;
        openId = id;
        showList(id);
        gsap.fromTo(panel, { height: startHeight }, { height: "auto", duration: 0.25, ease: "power2.inOut" });
        return;
      }

      openId = id;
      swapIcon(true);
      panel.hidden = false;
      showList(id);
      gsap.fromTo(panel, { height: 0, opacity: 0 }, { height: "auto", opacity: 1, duration: 0.3, ease: "power2.out" });
    }

    function close() {
      if (openId === null) return;
      const returnFocusTo = document.getElementById(`${openId}-btn`);
      openId = null;
      parentButtons.forEach((btn) => btn.setAttribute("aria-expanded", "false"));
      swapIcon(false);
      gsap.to(panel, {
        height: 0,
        opacity: 0,
        duration: 0.2,
        ease: "power2.in",
        onComplete: () => {
          panel.hidden = true;
        },
      });
      if (nav.contains(document.activeElement)) {
        returnFocusTo.focus({ preventScroll: true });
      }
    }

    parentButtons.forEach((btn) => {
      btn.addEventListener("click", () => open(btn.id.replace("-btn", "")));
    });

    // Memoji cycles when closed, acts as a back button when open
    navToggle.addEventListener("click", () => {
      if (openId) close();
      else cycleMemoji();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") close();
    });

    document.addEventListener("pointerdown", (event) => {
      if (openId && !nav.contains(event.target)) close();
    });
  });
</script>
