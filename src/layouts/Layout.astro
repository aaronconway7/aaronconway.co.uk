---
import "../styles/global.css";
// Supports weights 100-800
import "@fontsource-variable/jetbrains-mono";
// Preload the Latin subset so text doesn't wait on CSS discovery
import jetbrainsMonoLatin from "@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url";

export interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  ogImage?: string;
}

const {
  title = "Aaron Conway - Software Engineer",
  description = "Software engineer specializing in frontend web development. Building beautiful user interfaces and experiences. Made in Essex, UK 🇬🇧.",
  keywords = "Aaron Conway, web developer, React, TypeScript, frontend, JavaScript, software engineer, Essex, UK",
  ogImage = "/poster.jpeg",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- TEMP (design comparison): ?menu= ?intro= ?noise= ?card= pick a variant, ?compare shows a switcher. Remove once options are chosen. -->
    <script is:inline>
      (() => {
        const params = new URLSearchParams(location.search);
        const defaults = { menu: "current", intro: "current", noise: "gif", card: "fixed" };
        for (const [key, fallback] of Object.entries(defaults)) {
          document.documentElement.dataset[key] = params.get(key) || fallback;
        }
      })();
    </script>
    <link
      rel="preload"
      href={jetbrainsMonoLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:site_name" content="Aaron Conway" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(ogImage, Astro.site)} />

    <!-- Additional SEO -->
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Aaron Conway" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Aaron Conway",
        "url": "https://aaronconway.co.uk",
        "jobTitle": "Software Engineer",
        "description": "Software engineer specializing in frontend web development. Building beautiful user interfaces and experiences. Made in Essex, UK 🇬🇧.",
        "knowsAbout": ["JavaScript", "TypeScript", "React", "Web Development"],
        "sameAs": [
          "https://github.com/aaronconway7",
          "https://linkedin.com/in/aaronconway7"
        ]
      }
    </script>
  </head>
  <body class="bg-[#181818]">
    <slot />
    <!-- TEMP (design comparison) -->
    <script is:inline>
      (() => {
        const params = new URLSearchParams(location.search);
        if (!params.has("compare")) return;
        const options = {
          menu: ["current", "dropdown", "dropdown-sheet"],
          intro: ["current", "fast"],
          noise: ["gif", "svg", "none"],
          card: ["fixed", "responsive"],
        };
        const panel = document.createElement("form");
        panel.style.cssText =
          "position:fixed;left:8px;bottom:8px;z-index:2147483647;display:grid;gap:4px;padding:8px;border-radius:8px;background:#000c;color:#eee;font:11px ui-monospace,monospace";
        for (const [key, values] of Object.entries(options)) {
          const select = document.createElement("select");
          select.name = key;
          select.innerHTML = values
            .map((v) => `<option ${document.documentElement.dataset[key] === v ? "selected" : ""}>${v}</option>`)
            .join("");
          select.onchange = () => {
            params.set(key, select.value);
            location.search = params.toString();
          };
          const label = document.createElement("label");
          label.append(`${key} `, select);
          panel.append(label);
        }
        document.body.append(panel);
      })();
    </script>
  </body>
</html>
