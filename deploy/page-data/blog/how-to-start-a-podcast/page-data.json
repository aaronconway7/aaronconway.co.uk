dcast/index.md#audio-interface"},"content":[{"data":{},"marks":[],"value":"","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":"Audio Interface","nodeType":"text"}],"nodeType":"heading-3"},{"data":{},"content":[{"data":{},"marks":[],"value":"Required to record audio from XLR microphones and also ability to plug into your computer. From these, you can also adjust the volume of individual microphones.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"","nodeType":"text"},{"data":{"uri":"https://amzn.to/3b0KTjv"},"content":[{"data":{},"marks":[{"type":"bold"}],"value":"Behringer UMC404HD","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":"","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"list-item"},{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"","nodeType":"text"},{"data":{"uri":"https://amzn.to/39ZGQCS"},"content":[{"data":{},"marks":[],"value":"Zoom H6","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":"","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"list-item"},{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"","nodeType":"text"},{"data":{"uri":"https://amzn.to/3aaLZIu"},"content":[{"data":{},"marks":[],"value":"RØDECaster Pro","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":"","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"list-item"}],"nodeType":"unordered-list"},{"data":{},"content":[{"data":{},"marks":[],"value":"","nodeType":"text"},{"data":{"uri":"https://github.com/aaronconway7/my-website/blob/master/blog-content/how-to-start-a-podcast/index.md#headphones"},"content":[{"data":{},"marks":[],"value":"","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":"Headphones","nodeType":"text"}],"nodeType":"heading-3"},{"data":{},"content":[{"data":{},"marks":[],"value":"Not necessarilly needed but I'd recommend just so you can keep track of your audio levels and how it all sounds while recording.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"","nodeType":"text"},{"data":{"uri":"https://amzn.to/2Vretto"},"content":[{"data":{},"marks":[],"value":"Audio-Technica ATH-M20X","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":"","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"list-item"},{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"","nodeType":"text"},{"data":{"uri":"https://amzn.to/3aXz6UK"},"content":[{"data":{},"marks":[{"type":"bold"}],"value":"beyerdynamic DT 770 PRO Studio Headphones","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":"","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"list-item"}],"nodeType":"unordered-list"},{"data":{},"content":[{"data":{},"marks":[],"value":"","nodeType":"text"},{"data":{"uri":"https://github.com/aaronconway7/my-website/blob/master/blog-content/how-to-start-a-podcast/index.md#recording--editing"},"content":[{"data":{},"marks":[],"value":"","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":"Recording + Editing","nodeType":"text"}],"nodeType":"heading-2"},{"data":{},"content":[{"data":{},"marks":[],"value":"We use the same software to record and edit our audio. We started out by using Audacity (cross-platform) and/or Garageband (Mac only) - both free pieces of software but I found them both to be a bit basic and personally I didn't like the interface of Audacity lol. Having said that they are both perfectly usable to produce a high quality podcast. We now use Adobe Audition for recording and everything which can be a bit intimidating at first but after getting used to it I find it a lot quicker to do the most common actions I feel you need when a editing a podcast which is a simple selection of audio, splitting the clip(s) and deleting.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"When recording our podcast, we have 3 inputs (myself and Hamish as the 2 hosts + 1 other guest) so we record and edit using 3 seperate tracks. You can imagine this a 3 seperate files, one for each person and that audio file only contains the voice of that person.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"After editing, we mix the tracks creating one file and put this into an online tool called Auphonic. This analyses your audio and produces a professional quality result by doing some cool stuff such as levelling the audio to make sure it fits podcast standards, loudness normalization and others.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"","nodeType":"text"},{"data":{"uri":"https://github.com/aaronconway7/my-website/blob/master/blog-content/how-to-start-a-podcast/index.md#software"},"content":[{"data":{},"marks":[],"value":"","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":"Software","nodeType":"text"}],"nodeType":"heading-3"},{"data":{},"content":[{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"","nodeType":"text"},{"data":{"uri":"https://www.audacityteam.org/"},"content":[{"data":{},"marks":[],"value":"Audacity","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":"","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"list-item"},{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"","nodeType":"text"},{"data":{"uri":"https://www.apple.com/uk/mac/garageband/"},"content":[{"data":{},"marks":[],"value":"Garageband","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":"","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"list-item"},{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"","nodeType":"text"},{"data":{"uri":"https://www.adobe.com/uk/products/audition.html"},"content":[{"data":{},"marks":[{"type":"bold"}],"value":"Adobe Audition","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":"","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"list-item"},{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"","nodeType":"text"},{"data":{"uri":"https://auphonic.com/"},"content":[{"data":{},"marks":[{"type":"bold"}],"value":"Auphonic","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":"","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"list-item"}],"nodeType":"unordered-list"},{"data":{},"content":[{"data":{},"marks":[],"value":"","nodeType":"text"},{"data":{"uri":"https://github.com/aaronconway7/my-website/blob/master/blog-content/how-to-start-a-podcast/index.md#releasing"},"content":[{"data":{},"marks":[],"value":"","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":"Releasing","nodeType":"text"}],"nodeType":"heading-2"},{"data":{},"content":[{"data":{},"marks":[],"value":"To get your podcast published across podcast platforms (Spotify, Apple Podcasts, Google Podcasts etc) you need to use a podcast host. These hosts store your audio and allow your listeners to listen, download, and subscribe to your podcast by auto distributing it to the platforms via an RSS feed.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"You first create an account with this podcast host, tell them the name of you podcast, give it a description, upload your artwork (must be square) and some other fairly basic stuff. Once you've done this, every time you want to upload an episode you log into your host and upload it here. On average we've found that it takes 1-2 hours for the episode to be distributed everywhere after you've uploaded it (there have been occasions where Apple Podcasts in particular has taken longer). When you upload your first episode this can take even longer, potentially even weeks to get approved. Just be careful of that if you have a planned release date.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"","nodeType":"text"},{"data":{"uri":"https://github.com/aaronconway7/my-website/blob/master/blog-content/how-to-start-a-podcast/index.md#podcast-hosts"},"content":[{"data":{},"marks":[],"value":"","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":"Podcast Hosts","nodeType":"text"}],"nodeType":"heading-3"},{"data":{},"content":[{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"","nodeType":"text"},{"data":{"uri":"https://anchor.fm/"},"content":[{"data":{},"marks":[{"type":"bold"}],"value":"Anchor","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":"","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"list-item"},{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"","nodeType":"text"},{"data":{"uri":"https://libsyn.com/"},"content":[{"data":{},"marks":[],"value":"Libsyn","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":"","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"list-item"},{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"","nodeType":"text"},{"data":{"uri":"https://www.buzzsprout.com/"},"content":[{"data":{},"marks":[],"value":"Buzzsprout","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":"","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"list-item"}],"nodeType":"unordered-list"},{"data":{},"content":[{"data":{},"marks":[],"value":"","nodeType":"text"},{"data":{"uri":"https://github.com/aaronconway7/my-website/blob/master/blog-content/how-to-start-a-podcast/index.md#monetization"},"content":[{"data":{},"marks":[],"value":"","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":"Monetiz